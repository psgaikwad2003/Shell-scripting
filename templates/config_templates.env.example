# =============================================================================
#  ENTERPRISE SHELL TOOLKIT CONFIGURATION TEMPLATE
#  Copy this file to .env and configure your production values
# =============================================================================

# Server & Network Audit Settings
DEFAULT_SSH_PORT=22
TLS_AUDIT_PORT=443
HTTP_MONITOR_TIMEOUT_SECS=5

# Threshold Alerts
DISK_ALERT_THRESHOLD_PERCENT=85
MEMORY_ALERT_THRESHOLD_PERCENT=90
CPU_MAX_BURST_THRESHOLD=80
MAX_CONTAINER_RESTARTS=5

# Database & Cache Connectivity
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_SLOW_LOG_PATH=/var/log/mysql/slow.log
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Incident Response & Backups
BACKUP_ARCHIVE_DIR=/var/backups/production
INCIDENT_DUMP_DIR=/var/log/sre_incident_bundles
GPG_RECIPIENT_KEY_ID=ops@company.internal

# Notification Endpoints
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/EXAMPLE/WEBHOOK
PAGERDUTY_API_KEY=
